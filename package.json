{
  "name": "imsg-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI assistants read and send iMessage/SMS through a Mac, with send guardrails and Cloudflare Access authentication",
  "license": "MIT",
  "author": "Project Nomos",
  "homepage": "https://github.com/project-nomos/imsg-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/project-nomos/imsg-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/project-nomos/imsg-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "imessage",
    "sms",
    "messages",
    "macos",
    "claude",
    "cloudflare-access",
    "imsg"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "imsg-mcp": "src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "serve": "bun run src/cli.ts serve",
    "stdio": "bun run src/cli.ts stdio",
    "build": "scripts/build.sh",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jose": "6.2.17",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "6",
    "typescript-eslint": "^8.72.2"
  }
}
