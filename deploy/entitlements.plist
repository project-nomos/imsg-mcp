<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the bun-compiled imsg-mcp binary.
  JavaScriptCore needs JIT. Deliberately absent: allow-dyld-environment-variables and
  disable-library-validation. Without them, nobody can inject code into the process that
  holds Full Disk Access by setting DYLD_* variables or loading an unsigned library.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
